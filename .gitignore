# ==============================================================================
# MarineGuard AI – Root .gitignore
# ==============================================================================

# 1. Environment and Secrets
.env
.env.local
.env.*.local
*.pem
*.key
*.p12
*.pfx
secrets/

# 2. Python Cache and Compilation
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.tox/

# 3. Python Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# 4. Node & Frontend Dependencies and Build Outputs
node_modules/
frontend/node_modules/
dist/
frontend/dist/
dist-ssr/
frontend/dist-ssr/
*.local

# 5. Database Files & Snapshots
# Note: SQLite database is generated from backend/data/noaa_marine_microplastics.csv on startup
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
backend/marineguard.db
backend/backups/*
!backend/backups/.gitkeep

# 6. User Uploads and Runtime Generated Data
backend/data/uploads/*
!backend/data/uploads/.gitkeep
backend/data/annotated/*
!backend/data/annotated/.gitkeep
backend/data/cleaned/*
!backend/data/cleaned/.gitkeep
backend/data/reports/*
!backend/data/reports/.gitkeep

# 7. Logs and Crash Dumps
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 8. Operating System & Editor Files
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
*.sublime-project
*.sublime-workspace
