# ==============================================================================
# MarineGuard AI – Frontend Environment Configuration (.env.example)
# ==============================================================================
# IMPORTANT: All Vite frontend variables must start with the 'VITE_' prefix.
# Never place secret API keys, private passwords, or tokens in frontend variables,
# as they will be bundled into client-side JavaScript and exposed to end users.
# ==============================================================================

# Backend API Base URL
# - Local Development: Leave empty or omit to use Vite's dev proxy (defaults to '/api' -> http://127.0.0.1:8000).
# - Production Deployment: Set to your public backend URL (e.g., https://marineguard-api.onrender.com).
VITE_API_BASE_URL=

# Map Tile Provider URL (Optional)
# - Default: MarineGuard uses CartoDB Dark Matter & OpenStreetMap public tiles (NO API key required).
# - Custom Provider: If you choose to use Mapbox, Stadia Maps, or Maptiler, supply your tile URL template:
#   Example Mapbox: https://api.mapbox.com/styles/v1/mapbox/dark-v11/tiles/{z}/{x}/{y}?access_token=YOUR_MAPBOX_TOKEN
#   Example Stadia: https://tiles.stadiamaps.com/tiles/alidade_smooth_dark/{z}/{x}/{y}{r}.png?api_key=YOUR_STADIA_KEY
VITE_MAP_TILE_URL=

# Map Attribution (Optional, required if using a custom commercial tile service)
# Example: &copy; <a href="https://www.mapbox.com/about/maps/">Mapbox</a> &copy; <a href="http://www.openstreetmap.org/copyright">OpenStreetMap</a>
VITE_MAP_ATTRIBUTION=
