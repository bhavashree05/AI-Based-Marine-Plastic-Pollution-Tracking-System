# ==============================================================================
# MarineGuard AI – Unified Environment Configuration (.env.example)
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env' in the project root for local execution.
# 2. Never commit real passwords, secrets, or production '.env' files to Git.
# 3. For frontend variables (VITE_*), copy frontend/.env.example to frontend/.env
#    when deploying frontend independently (e.g. Vercel, Netlify).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND SERVER CONFIGURATION (Private / Server-Only)
# ------------------------------------------------------------------------------
# HOST: IP interface to bind Uvicorn server.
# - Local: 127.0.0.1
# - Docker / Production: 0.0.0.0
HOST=127.0.0.1

# PORT: TCP port on which FastAPI / Uvicorn listens.
# - Local default: 8000
# - Render / Railway / Cloud: Automatically assigned or 8000
PORT=8000

# DEBUG: Enables FastAPI debug diagnostics and stack traces.
# - Local development: True
# - Production: False
DEBUG=True

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (Private / Secret if using credentials)
# ------------------------------------------------------------------------------
# DATABASE_URL: Connection URI for database engine.
# - Default (SQLite): sqlite:///backend/marineguard.db
#   Auto-creates and seeds from NOAA dataset on first launch.
# - PostgreSQL + PostGIS (Production alternative):
#   postgresql://<db_user>:<db_password>@<db_host>:5432/<db_name>
DATABASE_URL=sqlite:///backend/marineguard.db

# ------------------------------------------------------------------------------
# 3. AI / COMPUTER VISION INFERENCE (Private / Server-Only)
# ------------------------------------------------------------------------------
# YOLO_MODEL_NAME: Ultralytics YOLO model weight file or path.
# - Local model: yolov8n.pt (bundled in project root, 6.5 MB)
# - Note: Runs 100% locally via PyTorch / CPU / GPU. Zero external AI API keys needed.
YOLO_MODEL_NAME=yolov8n.pt

# CV_CONFIDENCE_DEFAULT: Minimum confidence threshold (0.05 to 0.95) for bounding boxes.
# - Recommended default: 0.35
CV_CONFIDENCE_DEFAULT=0.35

# ------------------------------------------------------------------------------
# 4. SPATIAL DBSCAN CLUSTERING & HOTSPOT PRIORITIZATION (Private / Server-Only)
# ------------------------------------------------------------------------------
# DBSCAN_EPS_KM_DEFAULT: Cluster search radius in kilometers (Haversine metric).
# - Default: 150.0 (150 km oceanic aggregation radius)
DBSCAN_EPS_KM_DEFAULT=150.0

# DBSCAN_MIN_SAMPLES_DEFAULT: Minimum observations required to form a spatial cluster.
# - Default: 5
DBSCAN_MIN_SAMPLES_DEFAULT=5

# ------------------------------------------------------------------------------
# 5. CORS / CROSS-ORIGIN ACCESS CONTROL (Backend Setting)
# ------------------------------------------------------------------------------
# ALLOWED_ORIGINS (or CORS_ORIGINS): Comma-separated list of allowed frontend origins.
# - Local Development: http://localhost:5173,http://127.0.0.1:5173
# - Production: Set to your public domain(s), e.g., https://marineguard.yourdomain.com
# - Wildcard '*' can be used for open APIs (disables credential cookies).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# 6. FRONTEND CLIENT CONFIGURATION (Public - prefixed with VITE_)
# ------------------------------------------------------------------------------
# VITE_API_BASE_URL: Public URL of the backend API.
# - Local development: Leave empty (Vite dev server proxies '/api' to http://127.0.0.1:8000).
# - Separated Production (e.g. Vercel frontend + Render backend):
#   Set to your live backend endpoint, e.g. https://marineguard-api.onrender.com
VITE_API_BASE_URL=

# VITE_MAP_TILE_URL (Optional): Custom tile URL template.
# - Default: Empty (Uses free CartoDB Dark Matter & OpenStreetMap tiles. NO KEY NEEDED).
# - If using Mapbox: https://api.mapbox.com/styles/v1/mapbox/dark-v11/tiles/{z}/{x}/{y}?access_token=YOUR_MAPBOX_TOKEN
VITE_MAP_TILE_URL=

# VITE_MAP_ATTRIBUTION (Optional): Attribution for custom commercial tile service.
VITE_MAP_ATTRIBUTION=
